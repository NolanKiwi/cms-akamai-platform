# ─────────────────────────────────────────────────────────────
# CMS Akamai Platform — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql://cms_admin:cms_dev_password@localhost:5432/cms
DATABASE_TEST_URL=postgresql://cms_admin:cms_dev_password@localhost:5432/cms_test
POSTGRES_PASSWORD=cms_dev_password

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://:cms_dev_redis@localhost:6379
REDIS_PASSWORD=cms_dev_redis

# ── S3 / MinIO ────────────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000          # MinIO for local dev; remove for AWS
S3_REGION=us-east-1
S3_BUCKET_MEDIA=cms-media-dev
S3_BUCKET_VIDEO_SOURCE=cms-video-source-dev
S3_BUCKET_VIDEO_PROCESSED=cms-video-processed-dev
MINIO_ACCESS_KEY=cms_dev_access
MINIO_SECRET_KEY=cms_dev_secret_key_123
AWS_ACCESS_KEY_ID=                         # Set for AWS (leave blank for MinIO/IAM role)
AWS_SECRET_ACCESS_KEY=                     # Set for AWS (leave blank for MinIO/IAM role)

# ── OpenSearch ────────────────────────────────────────────────
OPENSEARCH_URL=https://localhost:9200
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=CmsD3v@dm1n!

# ── Auth / JWT ────────────────────────────────────────────────
JWT_PRIVATE_KEY_PATH=./keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=./keys/jwt-public.pem
PREVIEW_JWT_SECRET=dev-preview-secret-change-in-production

# ── OIDC (SSO) ────────────────────────────────────────────────
OIDC_ISSUER=https://accounts.google.com   # or Okta / Azure AD issuer URL
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_CALLBACK_URL=http://localhost:3001/api/auth/callback

# ── Akamai ────────────────────────────────────────────────────
# For local dev: Akamai is not in the critical path.
# These are used by purge-worker and Terraform.
AKAMAI_HOST=
AKAMAI_CLIENT_TOKEN=
AKAMAI_CLIENT_SECRET=
AKAMAI_ACCESS_TOKEN=
AKAMAI_NETWORK=staging                     # staging | production
AKAMAI_CONTRACT_ID=
AKAMAI_GROUP_ID=

# ── Origin Protection ─────────────────────────────────────────
ORIGIN_SHARED_SECRET=dev-origin-secret-change-in-production

# ── Observability ─────────────────────────────────────────────
OTLP_ENDPOINT=http://localhost:4318/v1/traces
GRAFANA_PASSWORD=cms_dev_grafana

# ── Email (local: Mailhog) ────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@example.com

# ── Feature Flags ─────────────────────────────────────────────
FEATURE_GRAPHQL=false
FEATURE_STREAMING=false
FEATURE_IMAGE_OPTIMIZATION=false
