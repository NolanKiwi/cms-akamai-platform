# ─────────────────────────────────────────────────────────────
# CMS Akamai Platform — 환경 변수
# .env.example → .env 복사 후 실제 값 입력
# .env 는 절대 git commit 금지
# ─────────────────────────────────────────────────────────────

# ── 공통 ──────────────────────────────────────────────────────
NODE_ENV=development

# ── CMS API (포트: 17000) ────────────────────────────────────
CMS_API_PORT=17000

# ── CMS Admin (포트: 17001) ──────────────────────────────────
CMS_ADMIN_PORT=17001
NEXT_PUBLIC_CMS_API_URL=http://localhost:17000

# ── Web Frontend (포트: 17002) ───────────────────────────────
WEB_FRONTEND_PORT=17002
NEXT_PUBLIC_API_URL=http://localhost:17000

# ── PostgreSQL (포트: 17432) ─────────────────────────────────
DATABASE_URL=postgresql://cms_admin:cms_dev_password@localhost:17432/cms
DATABASE_TEST_URL=postgresql://cms_admin:cms_dev_password@localhost:17432/cms_test
POSTGRES_PASSWORD=cms_dev_password

# ── Redis (포트: 17379) ──────────────────────────────────────
REDIS_URL=redis://:cms_dev_redis@localhost:17379
REDIS_PASSWORD=cms_dev_redis
REDIS_HOST=localhost
REDIS_PORT=17379

# ── S3 / MinIO (포트: 17900) ─────────────────────────────────
S3_ENDPOINT=http://localhost:17900
S3_REGION=us-east-1
S3_BUCKET_MEDIA=cms-media-dev
S3_BUCKET_VIDEO_SOURCE=cms-video-source-dev
S3_BUCKET_VIDEO_PROCESSED=cms-video-processed-dev
MINIO_ACCESS_KEY=cms_dev_access
MINIO_SECRET_KEY=cms_dev_secret_key_123
AWS_ACCESS_KEY_ID=cms_dev_access
AWS_SECRET_ACCESS_KEY=cms_dev_secret_key_123
# 로컬 MinIO 사용 시 위 값 사용, AWS 사용 시 S3_ENDPOINT 삭제

# ── OpenSearch (포트: 17200) ─────────────────────────────────
OPENSEARCH_URL=http://localhost:17200
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=CmsD3v@dm1n!

# ── Auth / JWT ────────────────────────────────────────────────
JWT_PRIVATE_KEY_PATH=./keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=./keys/jwt-public.pem
JWT_EXPIRES_IN=8h
PREVIEW_JWT_SECRET=dev-preview-secret-change-in-production
SESSION_SECRET=dev-session-secret-change-in-production

# ── OIDC (SSO) ────────────────────────────────────────────────
OIDC_ISSUER=https://accounts.google.com
OIDC_CLIENT_ID=your-client-id
OIDC_CLIENT_SECRET=your-client-secret
OIDC_CALLBACK_URL=http://localhost:17000/api/v1/auth/callback

# ── Akamai ────────────────────────────────────────────────────
AKAMAI_HOST=
AKAMAI_CLIENT_TOKEN=
AKAMAI_CLIENT_SECRET=
AKAMAI_ACCESS_TOKEN=
AKAMAI_NETWORK=staging
AKAMAI_CONTRACT_ID=
AKAMAI_GROUP_ID=

# ── Origin 보호 ───────────────────────────────────────────────
ORIGIN_SHARED_SECRET=dev-origin-secret-change-in-production

# ── 관찰가능성 ────────────────────────────────────────────────
OTLP_ENDPOINT=http://localhost:17318/v1/traces
JAEGER_URL=http://localhost:17686
PROMETHEUS_URL=http://localhost:17090
GRAFANA_PASSWORD=cms_dev_grafana

# ── 이메일 (Mailhog: 17025) ───────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=17025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@cms-local.dev

# ── 기능 플래그 ───────────────────────────────────────────────
FEATURE_GRAPHQL=false
FEATURE_STREAMING=false
FEATURE_IMAGE_OPTIMIZATION=true
FEATURE_BOT_MANAGER=false

# ── 업로드 제한 ───────────────────────────────────────────────
MAX_IMAGE_SIZE_MB=50
MAX_VIDEO_SIZE_MB=10240
MAX_DOCUMENT_SIZE_MB=100

# ── 레이트 리밋 ──────────────────────────────────────────────
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_SEC=60
RATE_LIMIT_API_MAX=1000
RATE_LIMIT_API_WINDOW_SEC=60
RATE_LIMIT_UPLOAD_MAX=20
RATE_LIMIT_UPLOAD_WINDOW_SEC=60
